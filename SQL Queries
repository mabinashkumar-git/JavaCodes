select * from Grades;
select * from Grades order by Marks desc;
select * from Grades where Marks = (select max(Marks) from Grades);
select distinct Marks from Grades order by Marks desc limit 1;
select max(Marks) as secondHighest from Grades where Marks < (select max(Marks) from Grades);
select distinct Marks from Grades order by Marks desc limit 1 offset 1;
select * from Grades where Marks = (select min(marks) from grades);
select min(Marks) as secondLowest from Grades where Marks > (select min(Marks) from Grades);

drop table Grades;


select * from StudentDetailsRO as sd join Grades as gd;
select * from StudentDetailsRO as sd join Grades as gd on sd.ID = gd.ID;
select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd join Grades as gd on sd.ID = gd.ID;
select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd inner join Grades as gd on sd.ID = gd.ID;

select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd left join Grades as gd on sd.ID = gd.ID;
select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID;

select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID order by Name desc;
select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID order by Name asc;

select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID where marks = (select max(Marks) from Grades);

select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID where Name like 'A%';

create view TableStartsWithA as select sd.Name, sd.ID, sd.Age, sd.Gender, sd.Location, gd.Grade, gd.Marks from StudentDetailsRO as sd right join Grades as gd on sd.ID = gd.ID where Name like 'A%';
select * from TableStartsWithA;




